# AeroGrid — variáveis de ambiente (cópia para .env.local)
# Documentação: docs/arquitetura/09-desenvolvimento-local.md
# NUNCA commite valores reais.

# Supabase (browser — seguras por design)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (SOMENTE SERVIDOR — proibido no bundle do cliente)
SUPABASE_SERVICE_ROLE_KEY=

# URL base da aplicação
NEXT_PUBLIC_SITE_URL=http://localhost:3000
